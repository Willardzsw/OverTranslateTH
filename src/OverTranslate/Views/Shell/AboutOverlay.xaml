<UserControl x:Class="OverTranslate.Views.Shell.AboutOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True">

    <!-- Scrim: swallows clicks so the page underneath stays inert, and dismisses on click -->
    <Grid x:Name="Scrim"
          Background="#8C000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">

        <!-- The card is centred in the scrim, so at an odd window width its left edge lands on a
             half pixel and WPF's default Ideal text formatting happily sub-pixel-positions every
             glyph there, leaving the whole card looking soft. Layout rounding snaps the card to
             whole device pixels so the text inside always starts on the pixel grid. -->
        <Border x:Name="Card"
                Width="420"
                UseLayoutRounding="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="14"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="26,22,26,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Close button floats over the title block's top-right corner -->
                <Button Grid.Row="0"
                        Style="{StaticResource OverlayCloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-6,-10,0"
                        ToolTip="{DynamicResource S.Common.Close}"
                        Click="CloseBtn_Click"/>

                <!-- Identity block. The icon is the one the taskbar and the shell header already
                     show, loaded from the same embedded .ico rather than a second copy that could
                     drift. Version and author sit on the same AppTextSecondary: the palette has
                     two text levels by design, so the step between them is font size, not a third
                     grey that would fail against AppCardBg. -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="26,2,26,18">
                    <Image x:Name="AppIcon"
                           Width="64" Height="64"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{DynamicResource S.App.Name}"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,11,0,0"/>
                    <TextBlock x:Name="VersionText"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="14"
                               Foreground="{DynamicResource AppTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{DynamicResource S.About.BasedOn}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="12.5"
                               Foreground="{DynamicResource AppTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- The MIT License and the third-party notices have to stay reachable once this build
                     is handed to someone else, so both open the copies shipped beside the executable. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource FlatButton}"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            Click="LicenseBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Text="&#xE8A5;"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"
                                       Foreground="{DynamicResource AppAccent}"/>
                            <TextBlock Text="{DynamicResource S.About.License}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppFont}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource FlatButton}"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            Click="ThirdPartyBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Text="&#xE8A5;"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"
                                       Foreground="{DynamicResource AppAccent}"/>
                            <TextBlock Text="{DynamicResource S.About.ThirdParty}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppFont}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Rectangle Grid.Row="2" Height="1" Margin="0,18,0,0"
                           Fill="{DynamicResource AppSeparator}"/>

                <TextBlock Grid.Row="3"
                           Text="{DynamicResource S.About.OpenSource}"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           LineHeight="18"
                           Margin="0,14,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
